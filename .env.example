# Subspace Outreach Pipeline Configuration Example
# Copy this file to '.env' and populate with your credentials.

# ==========================================
# API Keys (Required for production runs)
# ==========================================
OCEAN_API_KEY=your_ocean_api_key_here
PROSPEO_API_KEY=your_prospeo_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# API Endpoints (Defaults)
# ==========================================
OCEAN_API_ENDPOINT=https://api.ocean.io/v3/search/companies
PROSPEO_API_ENDPOINT=https://api.prospeo.io/search-person
APOLLO_API_ENDPOINT=https://api.apollo.io/api/v1/mixed_people/search
BREVO_API_ENDPOINT=https://api.brevo.com/v3/smtp/email

# ==========================================
# Pipeline Constraints & Budgets
# ==========================================
# Limit company count to prevent credit depletion
MAX_COMPANIES=5
# Hard limit on total credits to consume per run
MAX_CREDIT_BUDGET=100

# ==========================================
# Logging Configurations
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=logs/run.log

# ==========================================
# Email Outreach Config
# ==========================================
SENDER_NAME="Subspace Outreach Team"
SENDER_EMAIL=outreach@yourdomain.com
